<Window x:Class="EmrsTool.NewAppointment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Appointment" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Background="#0F0F0F" Margin="20">
        <StackPanel>
            <TextBlock Text="Sabon Appointment" Foreground="#00FF88" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBox x:Name="CustomerNameBox" Height="40" Margin="0,5"/>
            <ComboBox x:Name="ServiceBox" Height="40" Margin="0,5">
                <ComboBoxItem Content="Flashing"/>
                <ComboBoxItem Content="FRP Bypass"/>
            </ComboBox>
            <Button Content="Ajiye" Height="45" Background="#00FF88" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
