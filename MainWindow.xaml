<Window x:Class="EmrsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU TMT AMT Ultimate Pro Tool v2.0.8" Height="700" Width="1250"
        Background="#12121A" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Background="#0D0D14">
            <TextBlock Text="  SAFIYANU TMT AMT Ultimate Pro Tool v2.0.8" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
        </Border>

        <!-- Chipset Tabs like TMT -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#12121A" Margin="10,8">
            <Border Background="#FF7A00" CornerRadius="6" Width="130" Margin="3"><TextBlock Text="QUALCOMM" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="110" Margin="3"><TextBlock Text="MEDIATEK" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="90" Margin="3"><TextBlock Text="UNISOC" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="110" Margin="3"><TextBlock Text="HISILICON" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="100" Margin="3"><TextBlock Text="SAMSUNG" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="60" Margin="3"><TextBlock Text="ADB" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="90" Margin="3"><TextBlock Text="FASTBOOT" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="90" Margin="3"><TextBlock Text="NOMAND" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </StackPanel>

        <!-- Main 3 Columns -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Device List -->
            <Border Grid.Column="0" Background="#EFEFEF" Margin="8,0,4,0" CornerRadius="8">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Device List" FontWeight="Bold" FontSize="14"/>
                    <ListBox Grid.Row="1" Margin="0,5">
                        <ListBoxItem Background="#2E90FA" Foreground="White"><TextBlock Text="HUAWEI - HONOR 200 LITE"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="HONOR 8C - BKK-AL10"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="XIAOMI 13T - 2306EPUG6C"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="OPPO A78 - CPH2483"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="TECNO SPARK 10 - KI5"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="VIVO Y36 - V2247"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="ITEL P55 - P681L"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="REDMI NOTE 12 - 23021RA"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="SAMSUNG A14 - SM-A145"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="INFINIX HOT 30 - X6831"/></ListBoxItem>
                    </ListBox>
                    <Button Grid.Row="2" Content="Refresh List" Margin="0,5" Background="White" BorderBrush="#FF7A00"/>
                </Grid>
            </Border>

            <!-- MIDDLE: Log Console like TMT -->
            <Border Grid.Column="1" Background="#0A0A0F" Margin="4,0,4,0" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Log Console" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <Button Content="Clear Log" Margin="15,0,5,0" FontSize="10" Padding="8,2"/>
                        <Button Content="Save Log" Margin="5,0" FontSize="10" Padding="8,2"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" Margin="0,5" Background="Black" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"
                             Text="[14:22:01] SAFIYANU TMT AMT Ultimate v2.0.8 Init...&#x0a;[14:22:01] Checking drivers... OK&#x0a;[14:22:02] Selected: QUALCOMM - Mode: EDL&#x0a;[14:22:03] Scanning USB... Found 2 device(s)&#x0a;[14:22:04] Device: HUAWEI - Port: COM7 - READY&#x0a;[14:22:05] Device: HONOR 200 LITE - Port: COM9 - READY&#x0a;[14:22:06] Awaiting operation...&#x0a;[14:22:07] > Ready for command.&#x0a;[14:22:08] SUPPORT: XIAOMI | OPPO | TECNO | VIVO | ITEL | REDMI | HUAWEI | HONOR | SAMSUNG | INFINIX"/>
                </Grid>
            </Border>

            <!-- RIGHT: Operations like AMT -->
            <Border Grid.Column="2" Background="#1A1A24" Margin="4,0,8,0" CornerRadius="8">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Operations" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,5">
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#FF7A00"><TextBlock Text="Factory Reset and FRP" TextWrapping="Wrap" TextAlignment="Center"/></Button>
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#555"><TextBlock Text="Factory Reset" TextAlignment="Center"/></Button>
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#555"><TextBlock Text="Flash" TextAlignment="Center"/></Button>
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#555"><TextBlock Text="Reset FRP" TextAlignment="Center"/></Button>
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#555"><TextBlock Text="Lock Bootloader" TextAlignment="Center"/></Button>
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#555"><TextBlock Text="Unlock Bootloader" TextAlignment="Center"/></Button>
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#555"><TextBlock Text="RPMB Write" TextAlignment="Center"/></Button>
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#555"><TextBlock Text="RPMB Read" TextAlignment="Center"/></Button>
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#555"><TextBlock Text="Partition Manager" TextAlignment="Center"/></Button>
                        <Button Margin="4" Background="#252535" Foreground="White" BorderBrush="#555"><TextBlock Text="Health Check" TextAlignment="Center"/></Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Logo Bar -->
        <Border Grid.Row="3" Background="#0D0D14" BorderBrush="#FF7A00" BorderThickness="0,2,0,0">
            <Grid>
                <TextBlock Text="  SAFIYANU AMT  -  Ultimate Flashing &amp; Repair Suite  -  Powered by SAFIYANU ENGINE  -  Status: Ready | Port: Auto | License: PRO ACTIVE" Foreground="#FF9A00" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
