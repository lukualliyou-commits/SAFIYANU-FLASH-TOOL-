<Window x:Class="SafiyanuFlashTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU FLASH TOOL" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1A1A2E">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="SAFIYANU FLASH TOOL" Foreground="Gold" FontSize="28" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>
            <Button x:Name="CheckDriverBtn" Content="CHECK DRIVER" Width="250" Height="45" Margin="0,10" Click="CheckDriverBtn_Click" Background="Orange" Foreground="Black" FontWeight="Bold"/>
            <Button x:Name="FlashBtn" Content="START FLASH" Width="250" Height="45" Margin="0,10" Click="FlashBtn_Click" Background="Green" Foreground="White" FontWeight="Bold"/>
            <TextBlock x:Name="StatusText" Text="Ready..." Foreground="White" Margin="0,20,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
