<Window Title="SAFIYANU TMT WORLD v3.0 - REPAIR EDITION - 6647 Models" Height="800" Width="1200" Background="#0F0F0F">
<Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  
  <!-- LEFT MENU -->
  <Border Grid.Column="0" Background="#111">
    <StackPanel Margin="10">
      <TextBlock Text="🌍 WORLD v3.0" Foreground="#FF8C00" FontSize="18" FontWeight="Bold" Margin="0,10,0,20"/>
      <Button Content="📱 Read Info" Margin="0,5" Height="40" Background="#1E1E1E" Foreground="White" x:Name="BtnReadInfo"/>
      <Button Content="💾 Backup / Restore" Margin="0,5" Height="40" Background="#1E1E1E" Foreground="White" x:Name="BtnBackup"/>
      <Button Content="⚡ Flash Firmware" Margin="0,5" Height="40" Background="#FF8C00" Foreground="Black" FontWeight="Bold" x:Name="BtnFlash"/>
      <Button Content="🔧 ADB Tools" Margin="0,5" Height="40" Background="#1E1E1E" Foreground="White" x:Name="BtnADB"/>
      <Button Content="📂 Open Firmware Folder" Margin="0,5" Height="40" Background="#1E1E1E" Foreground="White" x:Name="BtnOpenFolder"/>
      <Separator Margin="0,20"/>
      <TextBlock Text="Models: 6647" Foreground="Gray" FontSize="11"/>
      <TextBlock Text="Tecno KN4 - WORLD EDITION" Foreground="#FF8C00" FontSize="10"/>
    </StackPanel>
  </Border>

  <!-- RIGHT - DEVICE + LOG -->
  <Grid Grid.Column="1" Margin="15">
    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="200"/></Grid.RowDefinitions>
    
    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="15" Padding="15">
      <Grid>
        <StackPanel>
          <TextBlock x:Name="DeviceInfoText" Text="📱 No Device Connected - Connect USB" Foreground="White" FontSize="14"/>
          <TextBlock x:Name="ModelSearchText" Text="Selected: KN4 Spark 50 WORLD EDITION" Foreground="#FF8C00" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <Button Content="🔍 Search 6647 Models" HorizontalAlignment="Right" Width="180" Background="#222" Foreground="White" x:Name="BtnSearchModels"/>
      </Grid>
    </Border>

    <DataGrid x:Name="LogGrid" Grid.Row="1" Margin="0,15,0,0" Background="#0F0F0F" Foreground="White" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150"/>
        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" Background="Black" CornerRadius="10" Margin="0,10,0,0" Padding="10">
      <ScrollViewer><TextBlock x:Name="LogText" Text="> SAFIYANU TMT WORLD v3.0 Ready&#x0a;> Connect device via USB&#x0a;> Select firmware folder..." Foreground="#0F0" FontFamily="Consolas" FontSize="12"/></Border>
  </Grid>
</Grid>
</Window>
