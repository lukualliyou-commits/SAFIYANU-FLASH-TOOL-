<Window x:Class="EmrsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU TMT AMT Ultimate Pro v2.0.8 - 1,234 Devices - OFFLINE" Height="820" Width="1280"
        Background="#0A0A0A" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#141414" BorderBrush="#FF8C00" BorderThickness="0,0,0,3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="50" Height="50" CornerRadius="25" BorderBrush="#FF8C00" BorderThickness="2" Margin="0,0,15,0">
                    <Border.Effect><DropShadowEffect Color="#FF8C00" BlurRadius="20" ShadowDepth="0"/></Border.Effect>
                    <Border.Background><ImageBrush ImageSource="logo.png"/></Border.Background>
                </Border>
                <TextBlock Text="ABOUT SAFIYANU TMT AMT - 1,234 DEVICES - OFFLINE TOOL" Foreground="#FF8C00" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="Black"><TextBlock Text="CEO - SAFIYANU - Sarkin Flashing - IMEI REPAIR SUPPORTED - NO INTERNET" Foreground="#FF8C00" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1A1A"><ScrollViewer><StackPanel Margin="10">
                <TextBlock Text="📱 DEVICES [1,234] - IMEI OK" Foreground="#FF8C00" FontWeight="Bold"/>
                <TextBlock Text="SAMSUNG A05 A06 A07 A07 ULTRA [412]" Foreground="White" Margin="0,10,0,0" FontWeight="Bold"/>
                <TextBlock Text="✓ A05 | A05s | A06 | A07 | A07 ULTRA - IMEI OK" Foreground="#00FF00" FontSize="11"/>
                <TextBlock Text="XIAOMI [318] - IMEI OK" Foreground="White" Margin="0,10,0,0" FontWeight="Bold"/>
                <TextBlock Text="HUAWEI / HONOR 200 LITE [150] - IMEI OK" Foreground="White" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBlock Text="OPPO VIVO TECNO INFINIX [354] - IMEI OK" Foreground="White" FontWeight="Bold" Margin="0,10,0,0"/>
            </StackPanel></ScrollViewer></Border>

            <Border Grid.Column="1" Background="#050505"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#222" Padding="10"><StackPanel Orientation="Horizontal"><TextBlock Text="📋 LOG - OFFLINE MODE" Foreground="White" FontWeight="Bold"/><Button Content="Clear" Margin="20,0" Padding="10,2" Click="ClearLog_Click"/></StackPanel></Border>
                <TextBox x:Name="LogBox" Grid.Row="1" Background="#050505" Foreground="#00FF00" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid></Border>

            <Border Grid.Column="2" Background="#1A1A1A"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#222" Padding="10"><TextBlock Text="⚙️ OPERATIONS - OFFLINE - IMEI INCLUDED" Foreground="White" FontWeight="Bold"/></Border>
                <ScrollViewer Grid.Row="1"><UniformGrid Columns="2" Margin="10">
                    <Button Content="📶 IMEI REPAIR&#x0a;1,234 Devices" Background="#FF8C00" Foreground="Black" FontWeight="Bold" Margin="5" Height="75" Click="IMEIRepair_Click"/>
                    <Button Content="💾 QCN Backup&#x0a;OFFLINE" Background="#333" Foreground="White" Margin="5" Height="75" Click="QCNBackup_Click"/>
                    <Button Content="📥 QCN Restore" Background="#333" Foreground="White" Margin="5" Height="75" Click="QCNRestore_Click"/>
                    <Button Content="Factory Reset&#x0a;+ FRP OFFLINE" Background="#333" Foreground="White" Margin="5" Height="75" Click="FactoryReset_Click"/>
                    <Button Content="🛡️ Reset FRP&#x0a;OFFLINE" Background="#333" Foreground="White" Margin="5" Height="75" Click="ResetFRP_Click"/>
                    <Button Content="⬇ Flash OFFLINE" Background="#333" Foreground="White" Margin="5" Height="75" Click="Flash_Click"/>
                    <Button Content="🔓 Unlock BL" Background="#333" Foreground="White" Margin="5" Height="75" Click="UnlockBL_Click"/>
                    <Button Content="🔒 Lock BL" Background="#333" Foreground="White" Margin="5" Height="75"/>
                </UniformGrid></ScrollViewer>
            </Grid></Border>
        </Grid>
        <Border Grid.Row="3" Background="#141414"><TextBlock Text="Status: OFFLINE READY | Port: AUTO | IMEI: SUPPORTED 1,234 Devices | A05 A06 A07 A07 ULTRA OK | No Internet" Foreground="#FF8C00" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</Window>
