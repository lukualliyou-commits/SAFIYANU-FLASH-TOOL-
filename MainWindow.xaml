<Window x:Class="EmrsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU AMT Pro Tool | v2.0.8 UNIVERSAL" Height="680" Width="1150"
        Background="White" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Device List like AMT -->
        <Border Grid.Column="0" Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Device List" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="White" CornerRadius="2">
                    <Grid>
                        <TextBlock Text=" HUAWEI" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                        <TextBlock Text="▼" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Background="White" CornerRadius="2" Margin="0,5,0,0">
                    <TextBlock Text=" Search for model" Foreground="#888888" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                </Border>
                <ListBox Grid.Row="3" Margin="0,8,0,0" Background="White" BorderBrush="#CCCCCC">
                    <ListBoxItem Background="#2E90FA" Foreground="White">
                        <StackPanel>
                            <TextBlock Text="HONOR 200 LITE" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="LLY-NX1" FontSize="10"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock Text="HONOR 8C" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="BKK-AL10 / BKK-LX2" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock Text="HONOR 90 LITE 5G" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="CRT-NX1 / CRT-N31" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock Text="XIAOMI 13T" FontWeight="Bold" FontSize="12" Foreground="#FF6A00"/>
                            <TextBlock Text="2306EPUG6C / 2306EPN60G" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock Text="OPPO A78" FontWeight="Bold" FontSize="12" Foreground="#FF6A00"/>
                            <TextBlock Text="CPH2483 / CPH2565" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock Text="TECNO SPARK 10" FontWeight="Bold" FontSize="12" Foreground="#FF6A00"/>
                            <TextBlock Text="KI5 / KI5q" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock Text="VIVO Y36" FontWeight="Bold" FontSize="12" Foreground="#FF6A00"/>
                            <TextBlock Text="V2247 / V2247A" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock Text="ITEL P55" FontWeight="Bold" FontSize="12" Foreground="#FF6A00"/>
                            <TextBlock Text="P681L / P681L" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock Text="REDMI NOTE 12" FontWeight="Bold" FontSize="12" Foreground="#FF6A00"/>
                            <TextBlock Text="23021RAAEG / 23021RAA2Y" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <!-- RIGHT: Operations like AMT -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Operations" FontWeight="Bold" FontSize="13" Margin="10,5" VerticalAlignment="Center"/>
            <UniformGrid Grid.Row="1" Columns="2" Rows="5" Margin="10,5,10,0">
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🔄" FontSize="18"/><TextBlock Text="  Factory Reset and FRP" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🔄" FontSize="18"/><TextBlock Text="  Factory Reset" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="⬇" FontSize="18" FontWeight="Bold"/><TextBlock Text="  Flash" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🧹" FontSize="18"/><TextBlock Text="  Reset FRP" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🔒" FontSize="18"/><TextBlock Text="  Lock Bootloader" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🔓" FontSize="18"/><TextBlock Text="  Unlock Bootloader" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="💾" FontSize="18"/><TextBlock Text="  RPMB Write" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="📄" FontSize="18"/><TextBlock Text="  RPMB Read" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="🗂" FontSize="18"/><TextBlock Text="  Partition Manager" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
                <Button Margin="5" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="❤" FontSize="18"/><TextBlock Text="  Health Check" VerticalAlignment="Center" Margin="5,0" FontSize="12"/></StackPanel>
                </Button>
            </UniformGrid>

            <!-- SAFIYANU AMT Logo Area -->
            <Border Grid.Row="2" Background="White" Margin="10">
                <Viewbox Stretch="Uniform">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="180" Height="140">
                            <Ellipse Fill="Black" Width="160" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="🤖" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-60,0,0,0"/>
                            <TextBlock Text="SAFIYANU" FontWeight="Black" FontSize="32" Foreground="#FF7A00" Margin="50,20,0,0"/>
                            <TextBlock Text="AMT" FontWeight="Black" FontSize="50" Foreground="#FF9A00" Margin="50,55,0,0"/>
                        </Grid>
                    </StackPanel>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</Window>
