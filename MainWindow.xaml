<Window x:Class="EmrsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EMRS TOOL UNIVERSAL - KOWA" Height="700" Width="1100"
        Background="#0F0F0F" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Border Background="Black">
            <TextBlock Text="EMRS TOOL UNIVERSAL - KOWA - MTK | QUALCOMM | SPD | SAMSUNG | XIAOMI" Foreground="#FFD700" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>
        <TabControl Grid.Row="1" Background="#1A1A1A">
            <TabItem Header=" MTK - Tecno/Infinix " Foreground="Black"/>
            <TabItem Header=" QUALCOMM " Foreground="Black"/>
            <TabItem Header=" SPD " Foreground="Black"/>
            <TabItem Header=" SAMSUNG " Foreground="Black"/>
            <TabItem Header=" XIAOMI " Foreground="Black"/>
            <TabItem Header=" ADB/FASTBOOT " Foreground="Black"/>
        </TabControl>
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#1E1E1E" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="UNIVERSAL FLASH - KOWA" Foreground="#FFD700" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Chipset (Auto Detect):" Foreground="Gray" Margin="0,15,0,3"/>
                    <ComboBox x:Name="CmbChipset" Height="32"><ComboBoxItem Content="Auto Detect - Kowa" IsSelected="True"/><ComboBoxItem Content="MTK"/><ComboBoxItem Content="Qualcomm"/><ComboBoxItem Content="SPD"/><ComboBoxItem Content="Samsung"/></ComboBox>
                    <TextBlock Text="Firmware:" Foreground="Gray" Margin="0,12,0,3"/>
                    <StackPanel Orientation="Horizontal"><TextBox x:Name="TxtFirmware" Width="240" Height="30" Background="#2D2D2D" Foreground="White"/><Button Content="..." Width="40" Margin="5,0,0,0" Background="#FFD700"/></StackPanel>
                    <Button Content="AUTO DETECT WAYA" Height="40" Background="Black" Foreground="#FFD700" BorderBrush="#FFD700" BorderThickness="1" Margin="0,15,0,8"/>
                    <Button Content="FULL FLASH KOWA" Height="45" Background="#FFD700" Foreground="Black" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="FRP BYPASS" Height="38" Background="#333" Foreground="White" Margin="0,0,4,0"/><Button Grid.Column="1" Content="FORMAT" Height="38" Background="#333" Foreground="White" Margin="4,0,0,0"/></Grid>
                    <TextBlock x:Name="TxtStatus" Text="Status: EMRS TOOL Ready - Windows 8 Compatible" Foreground="#00FF00" Margin="0,15,0,0" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Margin="10,0,0,0" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="LOG - EMRS KOWA" Foreground="#FFD700" FontWeight="Bold"/>
                    <TextBox x:Name="TxtLog" Grid.Row="1" Margin="0,10" Background="Black" Foreground="#00FF00" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" Text="> EMRS TOOL UNIVERSAL Ready...&#10;> MTK | Qualcomm | SPD | Samsung | Xiaomi&#10;> Windows 7/8/10/11 Compatible&#10;> Connect any phone...&#10;"/>
                    <ProgressBar x:Name="Prog" Grid.Row="2" Height="18" Value="0" Maximum="100" Foreground="#FFD700"/>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="Black"><TextBlock Text="© 2026 EMRS TOOL UNIVERSAL - KOWA - Windows 8 Compatible" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</Window>
