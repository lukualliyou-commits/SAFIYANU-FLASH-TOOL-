using System;
using System.Windows;
using System.Management;

namespace SafiyanuFlashTool
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
        }

        private void CheckDriverBtn_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                StatusText.Text = "Checking driver...";
                var searcher = new ManagementObjectSearcher("SELECT * FROM Win32_PnPEntity");
                bool found = false;
                foreach (ManagementObject obj in searcher.Get())
                {
                    string name = obj["Name"]?.ToString() ?? "";
                    if (name.ToLower().Contains("mediatek") || name.ToLower().Contains("mtk"))
                    {
                        found = true;
                        break;
                    }
                }
                if (found)
                {
                    StatusText.Text = "MTK Driver Found!";
                    MessageBox.Show("Driver found!");
                }
                else
                {
                    StatusText.Text = "Driver Not Found";
                    MessageBox.Show("MTK Driver not found - Please install driver");
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void FlashBtn_Click(object sender, RoutedEventArgs e)
        {
            StatusText.Text = "Ready to Flash!";
            MessageBox.Show("SAFIYANU FLASH TOOL - Ready to Flash!");
        }
    }
}
