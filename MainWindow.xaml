using System.Collections.Generic;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace EmrsTool
{
    public partial class NewAppointment : Window
    {
        private readonly List<PhoneModel> allModels = new();

        public NewAppointment()
        {
            InitializeComponent();

            LoadBrands();
            LoadPhoneModels();
        }

        private void LoadBrands()
        {
            BrandComboBox.ItemsSource = new List<string>
            {
                "All Brands",
                "TECNO",
                "Infinix",
                "itel",
                "Samsung",
                "Xiaomi",
                "Redmi",
                "POCO",
                "OPPO",
                "Vivo",
                "Nokia",
                "Huawei",
                "Honor",
                "Realme",
                "Motorola",
                "OnePlus",
                "ZTE",
                "iPhone"
            };

            BrandComboBox.SelectedIndex = 0;
        }

        private void LoadPhoneModels()
        {
            allModels.AddRange(new[]
            {
                new PhoneModel("TECNO", "Camon 30"),
                new PhoneModel("TECNO", "Camon 30 Pro"),
                new PhoneModel("TECNO", "Spark 20"),
                new PhoneModel("TECNO", "Spark 20 Pro"),
                new PhoneModel("TECNO", "Pova 6"),

                new PhoneModel("Infinix", "Hot 40"),
                new PhoneModel("Infinix", "Hot 40 Pro"),
                new PhoneModel("Infinix", "Note 40"),
                new PhoneModel("Infinix", "Note 40 Pro"),

                new PhoneModel("itel", "A70"),
                new PhoneModel("itel", "A60"),
                new PhoneModel("itel", "S23"),

                new PhoneModel("Samsung", "Galaxy A06"),
                new PhoneModel("Samsung", "Galaxy A05"),
                new PhoneModel("Samsung", "Galaxy A15"),
                new PhoneModel("Samsung", "Galaxy A25"),

                new PhoneModel("Xiaomi", "Redmi Note 13"),
                new PhoneModel("Xiaomi", "Redmi Note 12"),

                new PhoneModel("OPPO", "A58"),
                new PhoneModel("OPPO", "A78"),

                new PhoneModel("Vivo", "Y17"),
                new PhoneModel("Vivo", "Y27"),

                new PhoneModel("Nokia", "C32"),
                new PhoneModel("Nokia", "G22")
            });

            RefreshModels();
        }

        private void BrandComboBox_SelectionChanged(
            object sender,
            SelectionChangedEventArgs e)
        {
            RefreshModels();
        }

        private void ModelSearchBox_TextChanged(
            object sender,
            TextChangedEventArgs e)
        {
            RefreshModels();
        }

        private void RefreshModels()
        {
            if (BrandComboBox == null ||
                ModelSearchBox == null ||
                ModelListBox == null)
                return;

            string brand =
                BrandComboBox.SelectedItem?.ToString()
                ?? "All Brands";

            string search =
                ModelSearchBox.Text?.Trim()
                ?? string.Empty;

            IEnumerable<PhoneModel> results = allModels;

            if (brand != "All Brands")
            {
                results = results.Where(x =>
                    x.Brand.Equals(
                        brand,
                        System.StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(search))
            {
                results = results.Where(x =>
                    x.ModelName.Contains(
                        search,
                        System.StringComparison.OrdinalIgnoreCase));
            }

            var list = results.ToList();

            ModelListBox.ItemsSource = list;

            ModelCountText.Text =
                $"{list.Count} Models Found";
        }

        private void ModelListBox_SelectionChanged(
            object sender,
            SelectionChangedEventArgs e)
        {
            if (ModelListBox.SelectedItem is PhoneModel model)
            {
                SelectedModelBox.Text =
                    $"{model.Brand} {model.ModelName}";
            }
        }
    }

    public class PhoneModel
    {
        public string Brand { get; set; }
        public string ModelName { get; set; }

        public PhoneModel(string brand, string modelName)
        {
            Brand = brand;
            ModelName = modelName;
        }
    }
}
