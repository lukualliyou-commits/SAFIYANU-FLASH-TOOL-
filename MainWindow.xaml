<Window x:Class="EmrsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU FLASH TOOL - IBBI MASHEGO WORLD"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#0F0F0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#00FF88" CornerRadius="0">
            <TextBlock Text="IBBI MASHEGO WORLD - FLASH NOW v4"
                       FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="Black"/>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="#1A1A1A">
                <Button Content="📅 New Appointment" Height="50" Margin="10" Click="NewAppointment_Click"/>
                <Button Content="📱 Models (6,683)" Height="50" Margin="10"/>
                <Button Content="💰 Flashing" Height="50" Margin="10"/>
                <Button Content="🔓 FRP Service" Height="50" Margin="10"/>
            </StackPanel>

            <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
