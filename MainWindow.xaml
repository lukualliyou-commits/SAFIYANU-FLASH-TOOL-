<Window x:Class="EmrsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU TMT AMT ULTIMATE PRO v2.0.8 - IMEI REPAIR OFFLINE" Height="800" Width="1200"
        Background="#0F0F0F" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#141414" BorderBrush="#FF8C00" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="SAFIYANU TMT AMT ULTIMATE PRO v2.0.8 - IMEI REPAIR OFFLINE" Foreground="#FF8C00" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="Black">
            <TextBlock Text="CEO - SAFIYANU | OFFLINE READY | NO INTERNET | NO CREDIT | 1,234 DEVICES" Foreground="Lime" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1A1A">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="📱 DEVICES [1,234] - IMEI OK" Foreground="#FF8C00" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="SAMSUNG A05 A06 A07 A07 ULTRA [412]" Foreground="White" FontWeight="Bold" Margin="0,5"/>
                        <TextBlock Text="✓ A05 | A05s | A06 | A07 | A07 ULTRA" Foreground="Lime" FontSize="10" Margin="5,0,0,5"/>
                        <TextBlock Text="XIAOMI [318] - IMEI OK" Foreground="White" Margin="0,5"/>
                        <TextBlock Text="HUAWEI / HONOR [150] - IMEI OK" Foreground="White" Margin="0,5"/>
                        <TextBlock Text="OPPO VIVO TECNO INFINIX [354] - IMEI OK" Foreground="White" Margin="0,5"/>
                        <TextBlock Text="1,219 more devices..." Foreground="Gray" FontSize="10" Margin="0,20,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#050505">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#222" Padding="10">
                        <TextBlock Text="📋 LOGS - OFFLINE MODE" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <TextBox x:Name="LogBox" Grid.Row="1" Background="#050505" Foreground="Lime" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Text="Initializing SAFIYANU TMT AMT v2.0.8...&#x0a;Mode: OFFLINE | Credit: DISABLED&#x0a;1,234 devices loaded..."/>
                </Grid>
            </Border>

            <!-- RIGHT - ANAN AKA SAKA IMEI INPUT -->
            <Border Grid.Column="2" Background="#1A1A1A">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#222" Padding="10">
                        <TextBlock Text="🔧 IMEI TOOL - OFFLINE READY" Foreground="#FF8C00" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Margin="12">
                            <Border Background="#222" CornerRadius="8" Padding="12" BorderBrush="#FF8C00" BorderThickness="1" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="✏️ NEW IMEI 1 (15 Digits):" Foreground="#FF8C00" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtImei1" Height="42" FontSize="16" Text="352751084567890" Background="Black" Foreground="#00FF00" BorderBrush="#FF8C00" BorderThickness="2" Padding="10,8" FontFamily="Consolas" FontWeight="Bold"/>
                                    <TextBlock Text="✏️ NEW IMEI 2 (Dual SIM):" Foreground="#FF8C00" FontWeight="Bold" FontSize="12" Margin="0,12,0,5"/>
                                    <TextBox x:Name="TxtImei2" Height="42" FontSize="16" Text="352751084567891" Background="Black" Foreground="#00FF00" BorderBrush="#FF8C00" BorderThickness="2" Padding="10,8" FontFamily="Consolas" FontWeight="Bold"/>
                                    <TextBlock Text="Saka IMEI anan kafin REPAIR" Foreground="Gray" FontSize="9" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="1">
                                <Button Content="📶 IMEI REPAIR&#x0a;1,234 Devices" Background="#FF8C00" Foreground="White" Height="75" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Button Content="💾 QCN Backup OFFLINE" Background="#2A2A2A" Foreground="White" Height="50" Margin="0,0,0,8"/>
                                <Button Content="📥 QCN Restore" Background="#333" Foreground="White" Height="45" Margin="0,0,0,8"/>
                                <Button Content="Factory Reset + FRP OFFLINE" Background="#333" Foreground="White" Height="50" Margin="0,0,0,8"/>
                                <Button Content="🔓 Reset FRP OFFLINE" Background="#333" Foreground="White" Height="45" Margin="0,0,0,8"/>
                                <Button Content="⚡ Flash OFFLINE" Background="#444" Foreground="White" Height="45" Margin="0,0,0,8"/>
                                <Button Content="🔓 Unlock BL" Background="#333" Foreground="White" Height="40" Margin="0,0,0,5"/>
                                <Button Content="🔒 Lock BL" Background="#333" Foreground="White" Height="40"/>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#141414">
            <TextBlock Text="Ready | Offline | No Internet | License: PERMANENT | v2.0.8" Foreground="Gray" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
