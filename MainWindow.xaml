<Window x:Class="SafiyanuFlashTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU FLASH TOOL - Universal" Height="650" Width="950"
        WindowStartupLocation="CenterScreen" Background="#121212">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#000000"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="SAFIYANU" Foreground="#FFD700" FontSize="26" FontWeight="Bold"/><TextBlock Text=" FLASH TOOL " Foreground="White" FontSize="26" FontWeight="Bold"/><TextBlock Text="UNIVERSAL" Foreground="#FFD700" FontSize="16" VerticalAlignment="Bottom" Margin="10,0,0,5"/></StackPanel></Border>
        <Grid Grid.Row="1" Margin="15"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#1E1E1E" CornerRadius="10" Padding="15" Margin="0,0,10,0"><StackPanel>
                    <TextBlock Text="FILES (Kowa)" Foreground="#FFD700" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Scatter File:" Foreground="Gray" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,2,0,10"><TextBox x:Name="TxtScatter" Width="190" Height="30" Background="#2D2D2D" Foreground="White" BorderBrush="#FFD700"/><Button Content="..." Width="40" Height="30" Margin="5,0,0,0" Background="#FFD700" Click="BrowseScatter"/></StackPanel>
                    <TextBlock Text="DA File:" Foreground="Gray" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,2,0,10"><TextBox x:Name="TxtDA" Width="190" Height="30" Background="#2D2D2D" Foreground="White" BorderBrush="#FFD700"/><Button Content="..." Width="40" Height="30" Margin="5,0,0,0" Background="#FFD700" Click="BrowseDA"/></StackPanel>
                    <TextBlock Text="Auth File (Optional):" Foreground="Gray" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,2,0,15"><TextBox x:Name="TxtAuth" Width="190" Height="30" Background="#2D2D2D" Foreground="White" BorderBrush="#333"/><Button Content="..." Width="40" Height="30" Margin="5,0,0,0" Background="#555" Foreground="White" Click="BrowseAuth"/></StackPanel>
                    <Separator Background="#333" Margin="0,10"/><Button x:Name="BtnCheck" Content="CHECK MTK PORT" Height="40" Background="#000" Foreground="#FFD700" BorderBrush="#FFD700" BorderThickness="1" Margin="0,10,0,5" Click="CheckDriver_Click"/><TextBlock x:Name="TxtStatus" Text="Status: Waiting..." Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,5"/>
                    <Separator Background="#333" Margin="0,15"/><TextBlock Text="ACTIONS" Foreground="#FFD700" FontWeight="Bold" Margin="0,0,0,10"/><Button Content="FULL FLASH (Kowa)" Height="45" Background="#FFD700" Foreground="Black" FontWeight="Bold" Margin="0,0,0,8" Click="Flash_Click"/><Button Content="FRP BYPASS" Height="40" Background="#333" Foreground="White" Margin="0,0,0,8" Click="Frp_Click"/><Button Content="FORMAT / WIPE" Height="40" Background="#333" Foreground="White" Margin="0,0,0,8" Click="Format_Click"/><Button Content="READ INFO" Height="40" Background="#333" Foreground="White" Click="ReadInfo_Click"/>
                </StackPanel></Border>
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="10" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="LOG - Universal MTK" Foreground="#FFD700" FontWeight="Bold"/><TextBox x:Name="TxtLog" Grid.Row="1" Margin="0,10,0,10" Background="Black" Foreground="#00FF00" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="> Safiyanu Flash Tool Ready...&#10;> Supports: All Tecno, Infinix, Itel MTK&#10;> Connect phone in BROM mode...&#10;"/><StackPanel Grid.Row="2"><TextBlock Text="Progress:" Foreground="Gray" FontSize="11"/><ProgressBar x:Name="Progress" Height="20" Minimum="0" Maximum="100" Value="0" Background="#2D2D2D" Foreground="#FFD700" Margin="0,5,0,0"/><TextBlock x:Name="TxtProgress" Text="0%" Foreground="#FFD700" HorizontalAlignment="Center" FontSize="11"/></StackPanel></Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="Black"><TextBlock Text="© 2026 Safiyanu Flash Tool - Universal Edition" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid>
</Window>
