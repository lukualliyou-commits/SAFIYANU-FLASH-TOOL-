<Window x:Class="EmrsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU FLASH TOOL - EMRS TOOL v1.4.2" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#121212">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#00D4FF" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal" Margin="20,0">
                <Border Width="50" Height="50" CornerRadius="10" Background="#00D4FF">
                    <TextBlock Text="⚡" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="15,0" VerticalAlignment="Center">
                    <TextBlock Text="SAFIYANU - FLASH TOOL" Foreground="#00D4FF" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="EMRS TOOL - Universal MTK Flash - Windows 8/10/11 Compatible" Foreground="White" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="MTK CHIPSETS" Foreground="#00D4FF" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="• MT6765 Helio P35" Foreground="White" Margin="0,5"/>
                <TextBlock Text="• MT6768 Helio G85" Foreground="White" Margin="0,5"/>
                <TextBlock Text="• MT6785 Helio G90T" Foreground="White" Margin="0,5"/>
                <TextBlock Text="• MT6893 Dimensity 1000" Foreground="White" Margin="0,5"/>
                <TextBlock Text="• MT6877 Dimensity 800U" Foreground="White" Margin="0,5"/>
                <Button Content="Scatter File" Margin="0,20,0,0" Height="35" Background="#2D2D2D" Foreground="White"/>
                <Button Content="DA File" Margin="0,10" Height="35" Background="#2D2D2D" Foreground="White"/>
                <Button Content="Auth File" Margin="0,0,0,10" Height="35" Background="#2D2D2D" Foreground="White"/>
                <Button Content="START FLASH" Height="45" Background="#00D4FF" FontWeight="Bold" Foreground="Black" Margin="0,10,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="20,0,0,0" Background="#1E1E1E" CornerRadius="8" Padding="15">
                <TextBlock Text="[12:53:00] EMRS TOOL initialized v1.4.2&#x0a;[12:53:01] Loading configuration... OK&#x0a;[12:53:01] Detecting USB drivers... OK&#x0a;[12:53:02] Waiting for device..." Foreground="#00FF88" FontFamily="Consolas"/>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#00D4FF">
            <TextBlock Text="Ready - Windows 8/10/11 Compatible | Port: COM-- | Baud: 115200" Foreground="Black" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>
