<Window x:Class="EmrsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU TMT Pro Tool | v2.0.8" Height="700" Width="1250"
        Background="#0F0F14" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Top Menu like TMT -->
        <Border Grid.Row="0" Background="#16161F">
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <TextBlock Text="SAFIYANU TMT Pro Tool | v2.0.8" Foreground="#A0A0B0" FontSize="11" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text=" About Licence Screenshot Devices Help" Foreground="#606070" FontSize="11" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tabs like TMT: QUALCOMM MEDIATEK UNISOC... -->
        <Border Grid.Row="1" Background="#1A1A27" BorderBrush="#2A2A3A" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="5,0">
                <Button Content="QUALCOMM" Background="#6C5CE7" Foreground="White" Width="90" Height="28" Margin="5,0" FontWeight="Bold" FontSize="11" BorderThickness="0"/>
                <Button Content="MEDIATEK" Background="Transparent" Foreground="#8888A0" Width="90" Height="28" Margin="5,0" FontSize="11" BorderThickness="0"/>
                <Button Content="UNISOC" Background="Transparent" Foreground="#8888A0" Width="80" Height="28" Margin="5,0" FontSize="11" BorderThickness="0"/>
                <Button Content="HISILICON" Background="Transparent" Foreground="#8888A0" Width="90" Height="28" Margin="5,0" FontSize="11" BorderThickness="0"/>
                <Button Content="SAMSUNG" Background="Transparent" Foreground="#8888A0" Width="80" Height="28" Margin="5,0" FontSize="11" BorderThickness="0"/>
                <Button Content="ADB" Background="Transparent" Foreground="#8888A0" Width="50" Height="28" Margin="5,0" FontSize="11" BorderThickness="0"/>
                <Button Content="FASTBOOT" Background="Transparent" Foreground="#8888A0" Width="80" Height="28" Margin="5,0" FontSize="11" BorderThickness="0"/>
                <Button Content="NOMAND" Background="Transparent" Foreground="#8888A0" Width="80" Height="28" Margin="5,0" FontSize="11" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Log Panel like TMT -->
            <Border Grid.Column="0" Background="#0A0A0F" BorderBrush="#2A2A3A" BorderThickness="0,0,1,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="LOG | Firehose 15-1909 (Loader 9008) (EMMC)" Foreground="#6C5CE7" FontSize="10" FontFamily="Consolas"/>
                    <TextBox Grid.Row="1" x:Name="LogBox" Background="Transparent" Foreground="#00FF88" FontFamily="Consolas" FontSize="10.5" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="Main version: 1.0.0&#x0a;LUI Size: 0x00000&#x0a;LUI Data: 0x00000&#x0a;...&#x0a;Model: XIAOMI Redmi 11 / Poco M7&#x0a;Brand: XIAOMI&#x0a;Product: oppo / redmi / tecno / huawei / vivo / itel&#x0a;Supported: All Brands&#x0a;&#x0a;Chipset: QUALCOMM Snapdragon&#x0a;Loader: prog_ufs_firehose_SDM845_ddr.elf&#x0a;&#x0a;[READY] Waiting for EDL 9008 Device...&#x0a;[READY] SAFIYANU UNIVERSAL READY&#x0a;"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="#1A1A27" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"><TextBlock Text="Time: 23:18:11" Foreground="#8888A0" FontSize="10"/></Border>
                        <Border Background="#1A1A27" CornerRadius="4" Padding="8,4"><TextBlock Text="Duration: 21.75s" Foreground="#8888A0" FontSize="10"/></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Panel like TMT -->
            <Grid Grid.Column="1" Background="#13131A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Brand Loader Row -->
                <Border Grid.Row="0" Background="#1A1A27" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" SelectedIndex="0" Height="30" Background="#0F0F14" Foreground="White">
                            <ComboBoxItem>XIAOMI</ComboBoxItem>
                            <ComboBoxItem>OPPO</ComboBoxItem>
                            <ComboBoxItem>VIVO</ComboBoxItem>
                            <ComboBoxItem>TECNO</ComboBoxItem>
                            <ComboBoxItem>ITEL</ComboBoxItem>
                            <ComboBoxItem>INFINIX</ComboBoxItem>
                            <ComboBoxItem>HUAWEI</ComboBoxItem>
                            <ComboBoxItem>REDMI</ComboBoxItem>
                        </ComboBox>
                        <TextBox Grid.Column="1" Margin="10,0" Height="30" Background="#0F0F14" Foreground="White" BorderBrush="#2A2A3A" Text=" Xiaomi Redmi 11 - Poco M7 [sm6225] | Oppo | Vivo | Tecno | Itel"/>
                        <Button Grid.Column="2" Content="Server" Background="#2A2A3A" Foreground="White" Height="30" Margin="5,0" BorderThickness="0"/>
                        <Button Grid.Column="3" Content="Safe Format" Background="#2A2A3A" Foreground="White" Height="30" Margin="5,0" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Storage Tabs -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5">
                    <Button Content="Storage: F5MMC" Background="#2A2A3A" Foreground="White" Width="110" Height="28" Margin="0,0,10,0" BorderThickness="0" FontSize="10"/>
                    <Button Content="EFS Tools" Background="#1A1A27" Foreground="#8888A0" Width="80" Height="28" Margin="0,0,10,0" BorderThickness="0" FontSize="10"/>
                    <CheckBox Content="Backup Protected" Foreground="#8888A0" VerticalAlignment="Center" Margin="10,0" FontSize="10"/>
                    <CheckBox Content="Skip Protected" Foreground="#8888A0" VerticalAlignment="Center" Margin="10,0" FontSize="10"/>
                </StackPanel>

                <!-- Partition Table like TMT -->
                <DataGrid Grid.Row="2" Background="#13131A" BorderBrush="#2A2A3A" AutoGenerateColumns="False" HeadersVisibility="Column" RowBackground="#13131A" AlternatingRowBackground="#1A1A27" Foreground="White" GridLinesVisibility="Horizontal" Margin="10">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="L" Width="30"/>
                        <DataGridTextColumn Header="0" Width="30" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Partition" Width="120" Binding="{Binding Partition}"/>
                        <DataGridTextColumn Header="File Name" Width="180" Binding="{Binding File}"/>
                        <DataGridTextColumn Header="File Size" Width="80" Binding="{Binding Size}"/>
                        <DataGridTextColumn Header="Double Click to Load Partition" Width="200" Binding="{Binding Action}"/>
                        <DataGridTextColumn Header="Location" Width="*" Binding="{Binding Location}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Bottom Buttons like TMT -->
        <Border Grid.Row="3" Background="#1A1A27" BorderBrush="#2A2A3A" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Patch Bin -" Foreground="#8888A0" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text=" Select firmware folder..." Foreground="#606070" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Start Info" Background="#2A2A3A" Foreground="White" Height="35" Margin="5,0" BorderThickness="0"/>
                <Button Grid.Column="2" Content="Readback" Background="#2A2A3A" Foreground="White" Height="35" Margin="5,0" BorderThickness="0"/>
                <Button Grid.Column="3" Content="Reset" Background="#2A2A3A" Foreground="White" Height="35" Margin="5,0" BorderThickness="0"/>
                <Button Grid.Column="4" Content="Erase" Background="#2A2A3A" Foreground="White" Height="35" Margin="5,0" BorderThickness="0"/>
                <Button Grid.Column="5" Content="Select" Background="#6C5CE7" Foreground="White" Height="35" Margin="5,0" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
