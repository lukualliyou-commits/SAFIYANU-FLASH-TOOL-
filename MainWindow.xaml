<Window x:Class="EmrsTool.NewAppointment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Appointment"
        Height="650"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="SAFIYANU FANGALITY"
                   FontSize="25"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="0"
                   Text="08113353315"
                   Margin="0,35,0,0"/>

        <ComboBox x:Name="BrandComboBox"
                  Grid.Row="1"
                  Height="40"
                  Margin="0,25,0,10"
                  SelectionChanged="BrandComboBox_SelectionChanged"/>

        <TextBox x:Name="ModelSearchBox"
                 Grid.Row="2"
                 Height="42"
                 Padding="10"
                 FontSize="16"
                 TextChanged="ModelSearchBox_TextChanged"
                 ToolTip="Search phone model..."/>

        <ListBox x:Name="ModelListBox"
                 Grid.Row="3"
                 Margin="0,10,0,10"
                 DisplayMemberPath="ModelName"
                 SelectionChanged="ModelListBox_SelectionChanged"/>

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="ModelCountText"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="SelectedModelBox"
                     Height="40"
                     Padding="10"
                     IsReadOnly="True"/>
        </StackPanel>

    </Grid>
</Window>
