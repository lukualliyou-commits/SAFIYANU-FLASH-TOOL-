<Window x:Class="EmrsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAFIYANU TMT AMT Ultimate Pro Tool v2.0.8" Height="720" Width="1250"
        Background="#0D0D14" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D0D14">
            <TextBlock Text="  SAFIYANU TMT AMT Ultimate Pro Tool v2.0.8" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,8">
            <Border Background="#FF7A00" CornerRadius="6" Width="130" Margin="3"><TextBlock Text="QUALCOMM" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="110" Margin="3"><TextBlock Text="MEDIATEK" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="90" Margin="3"><TextBlock Text="UNISOC" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="110" Margin="3"><TextBlock Text="HISILICON" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="100" Margin="3"><TextBlock Text="SAMSUNG" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="60" Margin="3"><TextBlock Text="ADB" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Background="#333344" CornerRadius="6" Width="90" Margin="3"><TextBlock Text="FASTBOOT" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EFEFEF" Margin="8,0,4,0" CornerRadius="8">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Device List" FontWeight="Bold" FontSize="14"/>
                    <ListBox Grid.Row="1" Margin="0,5">
                        <ListBoxItem><TextBlock Text="HUAWEI"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="HONOR 200 LITE"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="XIAOMI 13T"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="OPPO A78"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="TECNO SPARK 10"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="VIVO Y36"/></ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#0A0A0F" Margin="4,0,4,0" CornerRadius="8">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Log Console" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <TextBox Grid.Row="1" Margin="0,5" Background="Black" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"
                             Text="[14:22:01] SAFIYANU Ultimate v2.0.8 Init...&#x0a;[14:22:02] CEO: SAFIYANU - Sarkin Flashing&#x0a;[14:22:03] Found 2 devices&#x0a;[14:22:04] Ready for command."/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#1A1A24" Margin="4,0,8,0" CornerRadius="8">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Operations" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,5">
                        <Button Margin="4" Background="#252535" Foreground="White" Content="Factory Reset and FRP"/>
                        <Button Margin="4" Background="#252535" Foreground="White" Content="Flash"/>
                        <Button Margin="4" Background="#252535" Foreground="White" Content="Reset FRP"/>
                        <Button Margin="4" Background="#252535" Foreground="White" Content="Lock Bootloader"/>
                        <Button Margin="4" Background="#252535" Foreground="White" Content="Unlock Bootloader"/>
                        <Button Margin="4" Background="#252535" Foreground="White" Content="RPMB Write"/>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM BAR WITH YOUR PHOTO -->
        <Border Grid.Row="3" Background="#0D0D14" BorderBrush="#FF7A00" BorderThickness="0,2,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <Border Width="55" Height="55" CornerRadius="27" BorderBrush="#FF7A00" BorderThickness="2" Margin="5,0">
                    <Border.Background>
                        <ImageBrush ImageSource="logo.png" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="  CEO - SAFIYANU - Sarkin Flashing  |  Created by SAFIYANU  |  Status: Ready | License: PRO ACTIVE" Foreground="#FF9A00" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
