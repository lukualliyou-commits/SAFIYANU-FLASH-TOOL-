name: Build SAFIYANU FLASH TOOL

on: [push]

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 8.0.x
      - run: dotnet publish EmrsTool.csproj -c Release -r win-x64 --self-contained -o publish
      - uses: actions/upload-artifact@v4
        with:
          name: EMRS-TOOL-Win8-Win11
          path: publish/
